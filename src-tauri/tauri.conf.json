{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Simple Mic Lock",
  "version": "0.2.0",
  "identifier": "com.salahaldinbilal.simplemiclock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Simple Mic Lock",
        "width": 440,
        "height": 620,
        "minWidth": 380,
        "minHeight": 420,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#14161A",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SalahaldinBilal",
    "shortDescription": "Keeps your microphone volume where you set it",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
